# Application Configuration
APP_NAME="Large-Scale Personalized Recommendation Engine"
ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Dataset Configuration
DEFAULT_DATASET=movielens
DATASET_VARIANT=ml-latest-small
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_FEATURES_DIR=./data/features

# Machine Learning & Embeddings
EMBEDDING_DIM=64
RETRIEVAL_BATCH_SIZE=256
RANKING_BATCH_SIZE=128
RETRIEVAL_EPOCHS=10
RANKING_EPOCHS=10
LEARNING_RATE=0.001
TOP_K_CANDIDATES=100
DEFAULT_TOP_N=10
MODELS_DIR=./models

# Vector Search (FAISS)
FAISS_INDEX_TYPE=IndexFlatIP
FAISS_INDEX_PATH=./models/retrieval/faiss_index.bin
ITEM_MAPPING_PATH=./models/retrieval/item_ids.json

# Caching (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL_SECONDS=300
REDIS_FALLBACK_TO_MEMORY=true

# Model Serving & Triton
SERVING_MODE=local
TRITON_SERVER_URL=localhost:8001
TRITON_MODEL_REPOSITORY=./models/model_repository
TRITON_TIMEOUT=5.0

# TensorFlow Legacy Keras Compatibility
TF_USE_LEGACY_KERAS=1
TF_ENABLE_ONEDNN_OPTS=0
